# Copy to .env.local and fill in. Per-clone: every value here changes for a new brand.
# NEXT_PUBLIC_* vars are baked at build time — changing them in Vercel requires a redeploy.

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>
SUPABASE_SERVICE_ROLE_KEY=<service role key>

# ── Telegram bot ──────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=<bot token from BotFather — must be the bot the Mini App opens from>
NEXT_PUBLIC_BOT_USERNAME=<bot username, no @>
TELEGRAM_WEBHOOK_SECRET=<random secret — validates incoming Telegram webhook requests>
ADMIN_TELEGRAM_ID=<numeric Telegram user id — DMs for tier-10 physical gold claims>

# ── Primary asset (Stellar) ───────────────────────────────────────────────────
NEXT_PUBLIC_PRIMARY_ASSET_CODE=<CODE>
NEXT_PUBLIC_PRIMARY_ASSET_ISSUER=<G... issuer address>
NEXT_PUBLIC_SHOWN_ASSETS=XLM,<CODE>:<G... issuer address>
NEXT_PUBLIC_HORIZON_URL=https://horizon.stellar.org

# ── Buy / rewards ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_DIRECT_BUY_XLM_ADDRESS=<G... address receiving XLM buys>
NEXT_PUBLIC_XLM_TO_TOKEN_RATE=1
REWARD_SENDER_SECRET=<S... Stellar secret key — signs auto-payout transactions>
# REWARD_MEMO=<optional — overrides default memo on reward payment txns>
NEXT_PUBLIC_REWARD_ASSET_ISSUER=<G... issuer for wrapped reward assets (wXLM/w<CODE>/wXRP/wUSDC/wGOLD/wSILVER/wCOPPER)>

# ── Admin ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_ADMIN_TELEGRAM_USERNAMES=<comma-separated usernames — client-side nav gate only>
ADMIN_SECRET_TOKEN=<random secret — real server-side admin auth (x-admin-token header)>

# ── Dev only — never set in Vercel production ─────────────────────────────────
NEXT_PUBLIC_DEV_BYPASS=true
